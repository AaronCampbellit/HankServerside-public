{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hank assistant execution v2 reserved contracts",
  "description": "M0 contract definitions. Does not advertise runtime support. Private records must never be copied to activity or logs.",
  "oneOf": [
    {
      "$ref": "#/$defs/model_turn"
    },
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/task"
    },
    {
      "$ref": "#/$defs/approval"
    },
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/receipt"
    },
    {
      "$ref": "#/$defs/client_capabilities"
    },
    {
      "$ref": "#/$defs/tool"
    }
  ],
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "note",
            "file",
            "folder",
            "calendar_event",
            "homeassistant_entity",
            "machine",
            "project_doc",
            "conversation",
            "app",
            "media_job",
            "calendar"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "device_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "type",
        "id",
        "scope"
      ]
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "input_tokens",
        "output_tokens"
      ]
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "tool_version": {
          "type": "integer",
          "minimum": 1
        },
        "arguments": {
          "type": "object",
          "maxProperties": 32
        }
      },
      "required": [
        "call_id",
        "tool",
        "tool_version",
        "arguments"
      ]
    },
    "model_turn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2
        },
        "kind": {
          "const": "model_turn"
        },
        "text": {
          "type": "string",
          "maxLength": 32768
        },
        "calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/call"
          },
          "maxItems": 24
        },
        "finish_reason": {
          "type": "string",
          "enum": [
            "tool_calls",
            "final",
            "needs_input",
            "length",
            "refused",
            "error"
          ]
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "continuation": {
          "type": "string",
          "maxLength": 131072
        }
      },
      "required": [
        "schema_version",
        "kind",
        "text",
        "calls",
        "finish_reason",
        "usage",
        "continuation"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "finish_reason": {
                "const": "tool_calls"
              }
            }
          },
          "then": {
            "properties": {
              "calls": {
                "minItems": 1
              },
              "text": {
                "maxLength": 0
              }
            }
          },
          "else": {
            "properties": {
              "calls": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "finish_reason": {
                "const": "final"
              }
            }
          },
          "then": {
            "properties": {
              "calls": {
                "maxItems": 0
              },
              "text": {
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "invalid_arguments",
            "permission_denied",
            "not_found",
            "file_target_unavailable",
            "attachment_unavailable",
            "file_destination_unavailable",
            "file_path_unavailable",
            "action_not_requested",
            "repeated_call",
            "approval_rejected",
            "target_ambiguous",
            "revision_conflict",
            "agent_offline",
            "client_unavailable",
            "approval_expired",
            "approval_required",
            "rate_limited",
            "timeout",
            "outcome_unknown",
            "budget_exhausted",
            "capability_unavailable",
            "internal_error",
            "cancelled"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "retryable": {
          "type": "boolean"
        },
        "next_action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "next_action"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2
        },
        "kind": {
          "const": "tool_result"
        },
        "call_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operation_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "outcome": {
          "type": "string",
          "enum": [
            "not_started",
            "accepted",
            "confirmed",
            "failed",
            "unknown"
          ]
        },
        "data": {
          "type": "object",
          "maxProperties": 64
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          },
          "maxItems": 100
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 100
        },
        "verification": {
          "type": "string",
          "enum": [
            "not_applicable",
            "pending",
            "observed",
            "unavailable"
          ]
        },
        "error": {
          "oneOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "kind",
        "call_id",
        "operation_id",
        "outcome",
        "data",
        "resources",
        "evidence_ids",
        "verification",
        "error"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "failed",
                  "unknown"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "$ref": "#/$defs/error"
              }
            }
          },
          "else": {
            "properties": {
              "error": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_active_ms": {
          "type": "integer",
          "minimum": 1
        },
        "turns_used": {
          "type": "integer",
          "minimum": 0
        },
        "calls_used": {
          "type": "integer",
          "minimum": 0
        },
        "tokens_used": {
          "type": "integer",
          "minimum": 0
        },
        "active_ms_used": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "max_turns",
        "max_calls",
        "max_tokens",
        "max_active_ms",
        "turns_used",
        "calls_used",
        "tokens_used",
        "active_ms_used"
      ]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2
        },
        "kind": {
          "const": "task"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "engine_version": {
          "const": 2
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "waiting_approval",
            "waiting_input",
            "waiting_client",
            "waiting_retry",
            "reconciling",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "cancel_requested": {
          "type": "boolean"
        },
        "budget": {
          "$ref": "#/$defs/budget"
        },
        "last_event_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "effects_uncertain": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "calls": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "call_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "tool": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "state": {
                "enum": [
                  "pending",
                  "running",
                  "waiting_approval",
                  "completed",
                  "failed",
                  "unknown",
                  "cancelled"
                ]
              },
              "attempts": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              }
            },
            "required": [
              "call_id",
              "tool",
              "state",
              "attempts"
            ]
          }
        },
        "error_code": {
          "enum": [
            "",
            "budget_exhausted",
            "invalid_checkpoint",
            "duplicate_call",
            "permission_denied",
            "invalid_tool_selection",
            "capability_unavailable",
            "model_unavailable",
            "outcome_unknown",
            "execution_failed"
          ]
        },
        "pending_approval": {
          "$ref": "#/$defs/approval"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "task_id",
        "session_id",
        "engine_version",
        "revision",
        "state",
        "cancel_requested",
        "budget",
        "last_event_sequence"
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2
        },
        "kind": {
          "const": "approval"
        },
        "approval_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "call_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "action_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          },
          "maxItems": 100
        },
        "decision": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected",
            "expired"
          ]
        },
        "consumed": {
          "type": "boolean"
        },
        "summary": {
          "$ref": "#/$defs/action_summary"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "approval_id",
        "task_id",
        "call_id",
        "action_digest",
        "revision",
        "expires_at",
        "resources",
        "decision",
        "consumed"
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2
        },
        "kind": {
          "const": "event"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "queued",
            "searching",
            "reading",
            "planning",
            "waiting_approval",
            "waiting_input",
            "waiting_client",
            "executing",
            "verifying",
            "retrying",
            "reconciling",
            "stopping",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "call_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "task_id",
        "sequence",
        "type",
        "call_id",
        "created_at"
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2
        },
        "kind": {
          "const": "receipt"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "call_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "action_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "not_started",
            "accepted",
            "confirmed",
            "failed",
            "unknown"
          ]
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          },
          "maxItems": 100
        },
        "result": {
          "$ref": "#/$defs/result"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "operation_id",
        "task_id",
        "call_id",
        "action_digest",
        "outcome",
        "resources",
        "result"
      ]
    },
    "client_capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2
        },
        "kind": {
          "const": "client_capabilities"
        },
        "device_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "assistant.execution.v2",
              "assistant.receipts.v1",
              "assistant.staging.v1"
            ]
          },
          "maxItems": 3
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "maxItems": 100
        }
      },
      "required": [
        "schema_version",
        "kind",
        "device_id",
        "capabilities",
        "tools"
      ]
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2
        },
        "kind": {
          "const": "tool_definition"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "input_schema": {
          "type": "object"
        },
        "output_schema": {
          "type": "object"
        },
        "effect": {
          "type": "string",
          "enum": [
            "read",
            "write"
          ]
        },
        "approval": {
          "type": "string",
          "enum": [
            "never",
            "required"
          ]
        },
        "retry": {
          "type": "string",
          "enum": [
            "safe_read",
            "idempotent",
            "reconcile",
            "never"
          ]
        },
        "verification": {
          "type": "string",
          "enum": [
            "not_applicable",
            "readback",
            "receipt",
            "unavailable"
          ]
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "maxItems": 10
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        },
        "max_result_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "permission_policy": {
          "type": "string",
          "enum": [
            "home_member",
            "notes_read",
            "notes_write",
            "files_read",
            "files_write",
            "homeassistant_read",
            "homeassistant_write",
            "calendar_read",
            "calendar_write",
            "machine_read",
            "machine_admin",
            "home_admin",
            "own_memory",
            "project_docs",
            "app_command",
            "evidence"
          ]
        },
        "idempotency": {
          "type": "string",
          "enum": [
            "read_only",
            "server_transaction",
            "destination_receipt",
            "reconcile_only"
          ]
        }
      },
      "required": [
        "schema_version",
        "kind",
        "name",
        "version",
        "description",
        "input_schema",
        "output_schema",
        "effect",
        "approval",
        "retry",
        "verification",
        "required_capabilities",
        "timeout_ms",
        "max_result_bytes",
        "permission_policy",
        "idempotency"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "effect": {
                "const": "write"
              }
            }
          },
          "then": {
            "properties": {
              "approval": {
                "const": "required"
              },
              "retry": {
                "enum": [
                  "idempotent",
                  "reconcile",
                  "never"
                ]
              },
              "verification": {
                "enum": [
                  "readback",
                  "receipt",
                  "unavailable"
                ]
              }
            }
          }
        }
      ]
    },
    "action_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "maxLength": 32768
        },
        "title": {
          "type": "string",
          "maxLength": 32768
        },
        "summary": {
          "type": "string",
          "maxLength": 32768
        },
        "confirmation_message": {
          "type": "string",
          "maxLength": 32768
        },
        "is_destructive": {
          "type": "boolean"
        },
        "details": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 256
              },
              "value": {
                "type": "string",
                "maxLength": 32768
              }
            },
            "required": [
              "label",
              "value"
            ]
          }
        }
      },
      "required": [
        "kind",
        "title",
        "confirmation_message"
      ]
    }
  }
}
