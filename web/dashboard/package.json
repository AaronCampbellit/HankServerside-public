{
  "name": "hank-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:dashboard && npm run build:mcp-kanban",
    "build:dashboard": "tsc --noEmit && vite build && node scripts/check-bundle-size.mjs",
    "build:mcp-kanban": "tsc --noEmit && node scripts/build-mcp-kanban.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest --run --maxWorkers=1",
    "check": "npm run test:run && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@vitejs/plugin-react": "^6.0.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9",
    "workbox-precaching": "^7.4.1"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.31.0"
  }
}
